PORT=5000
NODE_ENV=development

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifedrone
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=24h

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=LifeDrone <notifications@lifedrone.io>

# Application Links
APP_BASE_URL=http://localhost:5173
PROJECT_CONTACT_EMAIL=contact@lifedrone.io
